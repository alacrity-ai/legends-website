# ── DJKMD Legends — Environment Configuration ────────────────────────
#
# Copy this file to `.env.local` and fill in real values.
# Vite exposes variables prefixed with VITE_ to client code.
# None of these are secrets — they are public integration endpoints.
#
# All values have safe placeholder fallbacks in src/content/site.ts,
# so the site runs locally without any .env file at all.
# ──────────────────────────────────────────────────────────────────────

# Booking worker API URL
# Production: https://djkmdlegends.com  Local dev: http://localhost:8787
VITE_BOOKING_API_URL=

# YouTube video ID for the Media section embed
# Leave empty to hide the section. Set to a video ID to enable (e.g. dQw4w9WgXcQ)
VITE_YOUTUBE_VIDEO_ID=

# Google Calendar public URL (fallback link if event fetch fails)
VITE_GOOGLE_CALENDAR_PUBLIC_URL=

