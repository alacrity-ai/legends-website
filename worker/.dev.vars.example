# Local development secrets for wrangler dev
# Copy this file to .dev.vars and fill in real values
# This file is automatically picked up by `wrangler dev`

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.djkmdlegends.com

# This API Key should have permissions for Google Calendar API
GOOGLE_API_KEY=your-google-api-key

# Shared passcode that gates /guestlist (Bearer token from the frontend)
GUESTLIST_PASSCODE=your-passcode