# Local development secrets for wrangler dev
# Copy this file to .dev.vars and fill in real values
# This file is automatically picked up by `wrangler dev`

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.djkmdlegends.com

# This API Key should have permissions for Google Calendar API
GOOGLE_API_KEY=your-google-api-key

# Shared passcode that gates the /admin area (door check-in + event form).
# Sent as a Bearer token from the frontend.
ADMIN_PASSCODE=your-passcode

# Square (ticket_tracker app). Use SANDBOX credentials for local dev.
SQUARE_ACCESS_TOKEN=your-square-sandbox-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox

# Signature key from the Square webhook subscription (Developer Dashboard →
# Webhooks). Required for POST /api/square/webhook (auto-roster + auto sold-out).
# Set in prod with: npx wrangler secret put SQUARE_WEBHOOK_SIGNATURE_KEY
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
